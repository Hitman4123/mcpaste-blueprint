{
    "// note": "Editor type-checking only, from Blueprint's component template. The .dist types appear after `blueprint -dist` on a panel; the panel's own webpack build compiles the component.",
    "compilerOptions": {
        "moduleResolution": "node",
        "jsx": "react",
        "baseUrl": ".",
        "paths": {
            "@/*": ["../.dist/types/*"],
            "@definitions/*": ["../.dist/types/api/definitions/*"],
            "@feature/*": ["../.dist/types/components/server/features/*"],
            "@blueprint/*": ["../.dist/types/blueprint/*"]
        },
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "noEmit": true,
        "typeRoots": ["../.dist/types"]
    },
    "include": ["./**/*"],
    "exclude": ["node_modules"]
}
